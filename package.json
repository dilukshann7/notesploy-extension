{
  "name": "notesploy-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Notesploy browser extension: save pages, highlights and images to your Notesploy library.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contracts:types": "openapi-typescript ../notesploy-api/contracts/openapi.json -o src/lib/api-types.generated.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
