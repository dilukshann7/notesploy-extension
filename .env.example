# Copy to .env and adjust. Values are baked into the build at compile time.

# Production (defaults if unset)
WXT_API_BASE=https://api.notesploy.com
WXT_WEB_BASE=https://app.notesploy.com

# Local development (uncomment, and comment out the production values above)
# WXT_API_BASE=http://localhost:8787
# WXT_WEB_BASE=http://localhost:5173
